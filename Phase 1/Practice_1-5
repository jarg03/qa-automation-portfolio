//  async/await
const obtenerUsuario = async () => {
  const response = await fetch('https://shopflow-api.com/users/1');
  const data = await response.json();
  return data;
};

const crearProducto = async () => {
  try {
    const response = await fetch('https://shopflow-api.com/products');
    const data = await response.json();
    return data;
  } catch (error) {
    console.log('Error al crear producto:', error);
  }
};

